# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Which settings module to load. The Docker container ships with the hardened
# `prod` module. For local hacking without Docker you can use `dev`.
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False

# IMPORTANT: do not use a `$` character here. `docker compose` interpolates
# `$...` inside .env files, which silently corrupts the key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-without-dollar-signs

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# The timezone the business runs in. Every date-based check ("is this risk
# overdue?", "is control testing due?", "how long to contract renewal?") is
# computed in this timezone, so set it to the team's local zone rather than
# leaving it on UTC - otherwise overdues flick on a day early or late around
# midnight.
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# HTTPS / TLS
# ---------------------------------------------------------------------------
# The bundled stack serves plain HTTP on localhost, so this stays false. Once
# the app is behind a TLS-terminating reverse proxy (Caddy, nginx, Traefik, a
# cloud load balancer), set USE_TLS=true. That single switch enables:
#   - HTTP -> HTTPS redirect
#   - Secure session + CSRF cookies
#   - HSTS for one year (includeSubDomains)
#   - trusting X-Forwarded-Proto from the proxy
# See docs/DEPLOYMENT.md for a complete runbook and proxy examples.
USE_TLS=false

# Individual overrides (leave unset to follow USE_TLS).
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true           # header only; list submission is separate
# USE_X_FORWARDED_PROTO=true         # proxy terminates TLS, gunicorn does not

# How many trusted reverse proxies sit in front of the app (0 = none). Set to 1
# with a single TLS proxy so rate limits and sign-in backoff key on the real
# client address instead of the proxy. Only raise this if the proxy overwrites
# X-Forwarded-For.
# TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=grc_db
# Bootstrap/break-glass superuser. Used by the PostgreSQL container and by an
# operator; the application must never connect as this role.
POSTGRES_USER=grc_user
POSTGRES_PASSWORD=change-me-to-a-strong-admin-password

# Runtime application role. db/init/01-app-role.sh creates this non-superuser
# role on first initialisation and makes it the database owner, so FORCE ROW
# LEVEL SECURITY applies to application traffic. Generate a separate password:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_APP_USER=grc_app
DB_APP_PASSWORD=change-me-to-a-strong-app-password

POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Threat intelligence (optional; leave blank to disable external lookups)
# ---------------------------------------------------------------------------
# abuse.ch ThreatFox — free key at https://auth.abuse.ch/
# ABUSECH_AUTH_KEY=
# AlienVault OTX — free key at https://otx.alienvault.com/
# OTX_API_KEY=

# ---------------------------------------------------------------------------
# Email — digests & escalation notifications
# ---------------------------------------------------------------------------
# Default: the console backend. Digests/escalations are printed to the
# container log, which is perfect for demoing or a first run:
#   docker compose logs -f web
#
# To deliver real mail, uncomment the SMTP backend and fill in the host/creds:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false

# Shown as the From: header on every message.
DEFAULT_FROM_EMAIL=GRC Nexus <no-reply@grcnexus.local>

# Absolute base URL used to build the links inside emails (a scheduled job has
# no incoming request to derive it from). Set this to your real host.
SITE_BASE_URL=http://localhost:8000

# Escalations with no obvious owner (no assignee, no HOD) go here. Empty drops
# them. Comma-separated.
# ESCALATION_FALLBACK_EMAILS=soc@example.com,ciso@example.com

# --- scheduling knobs (read by the management commands) ---
# DIGEST_LOOKBACK_HOURS=24
# ESCALATION_GRACE_DAYS=1
# ESCALATION_WARN_DAYS=14

# --- localisation ---
# IANA timezone used for business date maths (localdate() everywhere). Default UTC.
# TIME_ZONE=Asia/Kathmandu

# --- sign-in throttling (core.login_throttle) ---
# Failed attempts are counted per account and per client IP in the default
# cache. After the threshold, the next attempt is refused for an exponentially
# increasing cool-down. This is not a permanent lockout: the counter decays
# with LOGIN_FAILURE_WINDOW. A successful sign-in clears the account counter
# only; the IP counter always decays on its own so one valid account cannot
# reset credential-stuffing protection for the whole address.
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW=900
# LOGIN_BACKOFF_BASE_SECONDS=30
# LOGIN_BACKOFF_MAX_SECONDS=900
# LOGIN_BACKOFF_MULTIPLIER=2
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_BACKOFF_BASE_SECONDS=60
# LOGIN_IP_BACKOFF_MAX_SECONDS=3600
# LOGIN_USERNAME_MAX_LENGTH=150
# LOGIN_PASSWORD_MAX_LENGTH=4096

# --- multi-factor authentication ---
# MFA is opt-in per user. Set MFA_REQUIRED_FOR_STAFF=true to force staff and
# superusers to enrol before they can use the app.
# MFA_ISSUER=GRC Nexus
# MFA_REQUIRED_FOR_STAFF=false
# MFA_MAX_FAILURES=5
# MFA_FAILURE_WINDOW=300
# MFA_BACKOFF_BASE_SECONDS=30
# MFA_BACKOFF_MAX_SECONDS=900
# MFA_BACKOFF_MULTIPLIER=2
# MFA_IP_MAX_FAILURES=20

# --- request rate limits (core.rate_limit) ---
# Per-process buckets. Point CACHES at Redis for a multi-worker deployment.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_PUBLIC=60
# RATE_LIMIT_SEARCH=60
# RATE_LIMIT_MEDIA=120
# RATE_LIMIT_WRITE=120
# RATE_LIMIT_READ=1200
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_AUTH_BACKOFF_BASE=30
# RATE_LIMIT_AUTH_BACKOFF_MAX=900
# RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2

# --- strict input limits (core.input_validation) ---
# Transport-level caps applied before a view runs. Domain validation still
# happens in Django forms and the typed helpers in core.input_validation.
# INPUT_MAX_PATH_LENGTH=2048
# INPUT_MAX_QUERY_STRING_LENGTH=4096
# INPUT_MAX_QUERY_PARAMS=50
# INPUT_MAX_QUERY_VALUE_LENGTH=1000
# INPUT_MAX_FORM_FIELDS=2000
# INPUT_MAX_FORM_VALUE_LENGTH=100000
# INPUT_MAX_FILENAME_LENGTH=255

# --- upload limits ---
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
# FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
# DATA_UPLOAD_MAX_NUMBER_FIELDS=2000
# DATA_UPLOAD_MAX_NUMBER_FILES=20
# MAX_EVIDENCE_UPLOAD_SIZE=10485760
# MAX_EVIDENCE_FILENAME_LENGTH=255
